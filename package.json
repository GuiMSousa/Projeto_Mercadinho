{
  "name": "contro-vend",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de controle de vendas e estoque para pequeno comerciante",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "tunnel": "npx --yes cloudflared@0.7.3 tunnel --url http://localhost:3100",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:products": "node prisma/seedProducts.js",
    "simulate:sales": "node prisma/simulateSales.js",
    "reset-password": "node prisma/resetPassword.js",
    "test": "node --test test/contract.test.js test/integration.test.js",
    "test:e2e": "node test/e2e/run.js",
    "spec:check": "npx --yes @fission-ai/openspec@1.13.2 validate --all --strict --no-interactive && npx --yes @redocly/cli@2.54.3 lint openspec/openapi.yaml && node --test test/contract.test.js",
    "spec:docs": "npx --yes @redocly/cli@2.54.3 build-docs openspec/openapi.yaml -o openspec/openapi.html",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@zxing/library": "0.23.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "playwright-core": "1.63.0",
    "prisma": "^5.20.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
